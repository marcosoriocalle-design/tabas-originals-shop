<!DOCTYPE html>
<html lang="es">
<head>
    <title><%= title %></title>
    <%- include('../partials/header') %>
</head>
<body class="flex flex-col min-h-screen text-white">
    <%- include('../partials/navbar') %>
    <main class="flex-grow container mx-auto px-4 py-12 max-w-4xl">
        <h1 class="text-3xl font-bold mb-8 uppercase border-b border-gray-800 pb-4">Tu Carrito</h1>
        
        <div id="cart-container"></div>
    </main>

    <script>
        function renderizarCarrito() {
            const carrito = JSON.parse(localStorage.getItem('tabas_carrito')) || [];
            const container = document.getElementById('cart-container');

            if (carrito.length === 0) {
                container.innerHTML = `
                    <div class="bg-brandDarker border border-gray-800 rounded-xl p-16 text-center shadow-xl">
                        <svg class="w-24 h-24 mx-auto text-gray-700 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                        <h2 class="text-2xl font-bold mb-4">Tu carrito está vacío</h2>
                        <p class="text-gray-400 mb-8">Parece que aún no has añadido ninguna zapatilla de nuestra colección exclusiva.</p>
                        <a href="/catalogo" class="inline-block bg-white text-black hover:bg-gray-200 font-bold py-3 px-8 rounded-lg uppercase tracking-wider transition shadow-lg">
                            Explorar Catálogo
                        </a>
                    </div>
                `;
                return;
            }

            let html = '<div class="space-y-6">';
            let total = 0;

            carrito.forEach((item, index) => {
                total += item.precio * item.cantidad;
                html += `
                <div class="flex items-center bg-black/70 backdrop-blur-md border border-gray-700/60 p-4 rounded-xl shadow-lg relative">
                    <img src="${item.imagen}" alt="${item.modelo}" class="w-24 h-24 md:w-32 md:h-32 object-cover rounded-lg">
                    <div class="ml-6 flex-grow">
                        <h3 class="text-xl md:text-2xl font-bold">${item.modelo}</h3>
                        ${item.talla ? `<span class="inline-block bg-brandRed/20 text-brandRed border border-brandRed/40 text-xs font-bold px-2.5 py-0.5 rounded-full mt-1">Talla: ${item.talla}</span>` : ''}
                        <p class="text-brandRed font-bold text-lg my-1">$${item.precio}</p>
                        <div class="flex items-center gap-4 mt-2">
                            <span class="text-gray-400">Cantidad:</span>
                            <div class="flex bg-gray-800 rounded-lg overflow-hidden border border-gray-700">
                                <button onclick="cambiarCantidad(${index}, -1)" class="px-4 py-1 bg-gray-800 hover:bg-gray-700 hover:text-brandRed transition font-bold">-</button>
                                <span class="px-4 py-1 border-x border-gray-700">${item.cantidad}</span>
                                <button onclick="cambiarCantidad(${index}, 1)" class="px-4 py-1 bg-gray-800 hover:bg-gray-700 hover:text-brandRed transition font-bold">+</button>
                            </div>
                        </div>
                    </div>
                    <button onclick="eliminarDelCarrito(${index})" class="absolute top-4 right-4 text-gray-500 hover:text-brandRed transition" title="Eliminar del carrito">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </div>`;
            });

            html += `</div>
            <div class="mt-10 bg-brandDarker border border-gray-800 p-8 rounded-xl flex flex-col md:flex-row justify-between items-center shadow-2xl">
                <div class="text-center md:text-left mb-6 md:mb-0">
                    <p class="text-gray-400 uppercase tracking-widest text-sm mb-1">Subtotal a pagar</p>
                    <h3 class="text-3xl font-bold">Total: <span class="text-brandRed">$${total}</span></h3>
                </div>
                <a href="/checkout" class="w-full md:w-auto bg-brandRed hover:bg-red-700 text-white font-bold py-4 px-10 rounded-xl uppercase tracking-wider transition shadow-lg shadow-red-500/30 text-center block">
                    Proceder al Pago
                </a>
            </div>`;

            container.innerHTML = html;
        }

        function cambiarCantidad(index, delta) {
            let carrito = JSON.parse(localStorage.getItem('tabas_carrito')) || [];
            if (carrito[index].cantidad + delta > 0) {
                carrito[index].cantidad += delta;
                localStorage.setItem('tabas_carrito', JSON.stringify(carrito));
                renderizarCarrito();
                if (window.actualizarBadgeCarrito) window.actualizarBadgeCarrito();
            }
        }

        function eliminarDelCarrito(index) {
            let carrito = JSON.parse(localStorage.getItem('tabas_carrito')) || [];
            carrito.splice(index, 1);
            localStorage.setItem('tabas_carrito', JSON.stringify(carrito));
            renderizarCarrito();
            if (window.actualizarBadgeCarrito) window.actualizarBadgeCarrito();
        }

        renderizarCarrito();
    </script>
</body>
</html>