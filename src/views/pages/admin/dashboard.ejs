<!DOCTYPE html>
<html lang="es">
<head>
    <title><%= title %></title>
    <%- include('../../partials/header') %>
</head>
<body class="flex flex-col min-h-screen bg-brandDark text-white">
    
    <!-- Navbar del Administrador -->
    <nav class="bg-brandDarker px-6 py-4 flex justify-between items-center border-b border-gray-800 sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <h1 class="text-xl font-bold text-white tracking-wide">
                Panel <span class="text-brandRed">Admin</span>
            </h1>
        </div>
        <div class="flex items-center gap-6">
            <a href="/" target="_blank" class="text-gray-400 hover:text-white transition text-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                Ver Tienda
            </a>
            <a href="/admin/logout" class="bg-gray-800 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition text-sm font-bold">Cerrar Sesión</a>
        </div>
    </nav>

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl">
        <div class="flex justify-between items-end mb-8">
            <div>
                <h2 class="text-3xl font-bold uppercase mb-2">Gestión de Zapatillas</h2>
                <p class="text-gray-400">Sube y actualiza las fotos de tu inventario desde aquí.</p>
            </div>
            <div class="bg-gray-900 border border-gray-800 px-4 py-2 rounded-lg text-sm text-gray-400">
                Total productos: <span class="text-white font-bold"><%= productos.length %></span>
            </div>
        </div>

        <div class="bg-brandDarker border border-gray-800 rounded-xl overflow-hidden shadow-2xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-900 border-b border-gray-800 text-gray-400 text-sm uppercase tracking-wider">
                            <th class="p-4 font-medium">Foto Actual</th>
                            <th class="p-4 font-medium">Código (ID)</th>
                            <th class="p-4 font-medium">Modelo y Detalle</th>
                            <th class="p-4 font-medium">Marca</th>
                            <th class="p-4 font-medium text-right">Precio</th>
                            <th class="p-4 font-medium">Actualizar Foto</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        <% productos.forEach(p => { %>
                            <tr class="hover:bg-gray-900/50 transition">
                                <!-- FOTO ACTUAL -->
                                <td class="p-4">
                                    <% if (p.imagen_url) { %>
                                        <img src="<%= p.imagen_url %>" alt="Foto" class="w-16 h-16 object-cover rounded-lg border border-gray-700">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gray-800 rounded-lg border border-gray-700 flex items-center justify-center text-xs text-gray-500 text-center p-1">
                                            Sin Foto
                                        </div>
                                    <% } %>
                                </td>
                                
                                <!-- CODIGO -->
                                <td class="p-4 font-mono text-sm text-gray-400"><%= p.Codigo %></td>
                                
                                <!-- DESCRIPCION -->
                                <td class="p-4">
                                    <p class="font-bold text-white text-sm"><%= p.Descripcion %></p>
                                </td>
                                
                                <!-- MARCA -->
                                <td class="p-4 text-sm text-gray-400 uppercase"><%= p.MARCA %></td>
                                
                                <!-- PRECIO -->
                                <td class="p-4 text-right font-bold text-brandRed">
                                    $<%= p['P. Venta'] || p['P.Normal'] || 0 %>
                                </td>
                                
                                <!-- FORMULARIO DE SUBIDA / ELIMINAR FOTO -->
                                <td class="p-4">
                                    <div class="flex items-center gap-2">
                                        <form action="/admin/producto/<%= p.Codigo %>/imagen" method="POST" enctype="multipart/form-data">
                                            <label class="cursor-pointer bg-gray-800 hover:bg-gray-700 text-white px-3 py-2 rounded border border-gray-700 transition text-xs whitespace-nowrap flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                                <input type="file" name="imagen" accept="image/*" class="hidden" required onchange="this.form.submit()">
                                                Subir
                                            </label>
                                        </form>

                                        <% if (p.imagen_url) { %>
                                            <form action="/admin/producto/<%= p.Codigo %>/imagen/eliminar" method="POST" onsubmit="return confirm('¿Estás seguro de que deseas eliminar la foto de este modelo?');">
                                                <button type="submit" class="bg-red-950/60 hover:bg-red-600 border border-red-800 hover:border-red-500 text-red-300 hover:text-white px-2.5 py-2 rounded transition text-xs flex items-center gap-1" title="Eliminar foto">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    Eliminar Foto
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    
    <!-- Script para notificaciones emergentes -->
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success')) {
            alert('✅ ¡Foto actualizada exitosamente en la tienda!');
            window.history.replaceState({}, document.title, "/admin");
        }
        if (urlParams.has('deleted')) {
            alert('🗑️ ¡Foto eliminada correctamente!');
            window.history.replaceState({}, document.title, "/admin");
        }
        if (urlParams.has('error')) {
            alert('❌ Hubo un error al procesar la foto.');
            window.history.replaceState({}, document.title, "/admin");
        }
    </script>
</body>
</html>
